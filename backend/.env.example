# ---------------------------------------------------------------
# Portal de Solicitações - Backend
# Copie para .env e ajuste conforme o ambiente.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=portal
DATABASE_PASSWORD=portal
DATABASE_NAME=portal_solicitacoes

# Executa as migrations SQL (database/migrations) ao iniciar a API
DATABASE_MIGRATE_ON_START=true
MIGRATIONS_DIR=../database/migrations

# Sessão
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# true obrigatório em produção (HTTPS)
COOKIE_SECURE=false

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Confiar no proxy reverso para obter o IP real (true quando atrás do Nginx)
TRUST_PROXY=false

# Fuso usado para interpretar os filtros de período (datas sem horário)
APP_TIMEZONE=America/Fortaleza

# Documentação interativa em /api/docs
SWAGGER_ENABLED=true
